meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin123"
  }
}

script:post-response {
  const b = res.body;
  if (b && b.accessToken) {
    bru.setEnvVar("accessToken", b.accessToken, { persist: true });
  }
  if (b && b.refreshToken) {
    bru.setEnvVar("refreshToken", b.refreshToken, { persist: true });
  }
}
